PORT=3003
MONGODB_URI=mongodb://admin:password@127.0.0.1:27017/homswag?authSource=admin
MONGO_DATABASE=homswag
KAFKA_BROKERS=127.0.0.1:9094
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
# Safe fallback for offices without a persisted admin-controlled mode.
EARNINGS_MODE=shadow

# Production: inject the exact same JWT_SECRET as the TypeScript server.
# Local workspace alternative: read only JWT_SECRET from the server dotenv.
JWT_SECRET=
JWT_SECRET_ENV_FILE=../server/.env
